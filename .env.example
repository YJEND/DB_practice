# ------------------------------------------------------------------
# 로컬 실습 전용 설정. 이 파일을 .env 로 복사해서 사용합니다.
#   cp .env.example .env
# 계정/비밀번호는 로컬 도커 컨테이너에서만 쓰는 값입니다.
# 포트가 이미 사용 중이면 아래 *_PORT 값만 바꾸면 됩니다.
# ------------------------------------------------------------------
COMPOSE_PROJECT_NAME=dbpractice

# PostgreSQL (pgvector 포함)
POSTGRES_PORT=5432
POSTGRES_USER=lab
POSTGRES_PASSWORD=lab
POSTGRES_DB=lab

# Redis
REDIS_PORT=6379

# MySQL (선택, `make up-mysql` 로만 기동)
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=lab
MYSQL_USER=lab
MYSQL_PASSWORD=lab
MYSQL_DATABASE=lab
